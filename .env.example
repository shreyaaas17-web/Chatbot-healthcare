# Required for Neon-backed accounts and writes.
DATABASE_URL=

# Required for signed httpOnly JWT cookies (32+ random characters).
JWT_SECRET=

# Optional OpenAI-compatible key; all requests are made server-side.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional; creates an admin account on first DB initialization.
ADMIN_EMAIL=
ADMIN_PASSWORD=
